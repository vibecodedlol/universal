-- ==========================================
-- FRAME UPDATE LOOP
-- ==========================================
local lastStatusText = ""
local renderConn = RunService.RenderStepped:Connect(function()
	local character = localPlayer.Character
	local root = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head"))
	local originPos = root and root.Position

	local fruitCount = 0
	local statusLines = {}

	for obj, data in pairs(trackedFruits) do
		if not fruitEspEnabled or not isValidFruit(obj) then
			if data.Billboard then data.Billboard:Destroy() end
			trackedFruits[obj] = nil
		else
			local targetPart = data.TargetPart
			if targetPart and targetPart:IsDescendantOf(Workspace) then
				data.Billboard.Enabled = true
				fruitCount += 1
				local dist = originPos and math.floor((targetPart.Position - originPos).Magnitude) or 0
				data.TextLabel.Text = string.format("%s\n[%d studs]", obj.Name, dist)
				table.insert(statusLines, string.format("• %s [%d studs]", obj.Name, dist))
			else
				data.Billboard.Enabled = false
			end
		end
	end

	for obj, data in pairs(trackedChests) do
		if not chestEspEnabled or not isValidChest(obj) then
			if data.Billboard then data.Billboard:Destroy() end
			trackedChests[obj] = nil
		else
			local targetPart = data.TargetPart
			if targetPart and targetPart:IsDescendantOf(Workspace) then
				data.Billboard.Enabled = true
				local dist = originPos and math.floor((targetPart.Position - originPos).Magnitude) or 0
				data.TextLabel.Text = string.format("Chest\n[%d studs]", dist)
			else
				data.Billboard.Enabled = false
			end
		end
	end

	for obj, data in pairs(trackedFlowers) do
		if not flowerEspEnabled or not isValidFlower(obj) then
			if data.Billboard then data.Billboard:Destroy() end
			trackedFlowers[obj] = nil
		else
			local targetPart = data.TargetPart
			if targetPart and targetPart:IsDescendantOf(Workspace) then
				data.Billboard.Enabled = true
				local labelName = (obj.Name:lower() == "flower1") and "Blue Flower" or "Red Flower"
				local dist = originPos and math.floor((targetPart.Position - originPos).Magnitude) or 0
				data.TextLabel.Text = string.format("%s\n[%d studs]", labelName, dist)
			else
				data.Billboard.Enabled = false
			end
		end
	end

	local newStatusText = (#statusLines > 0)
		and table.concat(statusLines, "\n")
		or "No spawned Devil Fruits detected."
	if newStatusText ~= lastStatusText then
		lastStatusText = newStatusText
		pcall(function()
			StatusParagraph:SetDesc(newStatusText)
		end)
	end
end)
table.insert(connections, renderConn)

-- Detect newly spawned objects instantly
local addedConn = Workspace.DescendantAdded:Connect(function(obj)
	task.wait(0.25)
	if fruitEspEnabled and isValidFruit(obj) then
		createFruitESP(obj)
	end
	if chestEspEnabled and isValidChest(obj) then
		createChestESP(obj)
	end
	if flowerEspEnabled and isValidFlower(obj) then
		createFlowerESP(obj)
	end
end)
table.insert(connections, addedConn)

-- Global Cleanup Function
getgenv().VibecodedHub_BloxFruits_Cleanup = function()
	for _, conn in ipairs(connections) do
		if conn.Connected then conn:Disconnect() end
	end
	clearTable(trackedFruits)
	clearTable(trackedChests)
	clearTable(trackedFlowers)
	if visualFolder then visualFolder:Destroy() end
	if Window and Window.Destroy then
		pcall(function() Window:Destroy() end)
	end
end

-- Initial Scan
scanWorkspace()
