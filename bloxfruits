-- ==========================================
-- HELPERS & VALIDATION
-- ==========================================
local function getTargetPart(obj)
	if obj:IsA("BasePart") then
		return obj
	elseif obj:IsA("Model") or obj:IsA("Tool") then
		return obj:FindFirstChild("Handle") or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local function isPlayerOwned(obj)
	if Players:GetPlayerFromCharacter(obj) or obj:IsDescendantOf(Workspace.CurrentCamera) then
		return true
	end
	local ancestorModel = obj:FindFirstAncestorOfClass("Model")
	if ancestorModel and ancestorModel:FindFirstChildOfClass("Humanoid") then
		return true
	end
	return false
end

local function isValidFruit(obj)
	if not obj or not obj.Parent or not obj:IsDescendantOf(Workspace) then return false end
	if not (obj:IsA("Tool") or obj:IsA("Model")) then return false end
	if isPlayerOwned(obj) then return false end

	local lowerName = obj.Name:lower()
	if not lowerName:find("fruit", 1, true) then
		return false
	end

	local targetPart = getTargetPart(obj)
	if not targetPart or targetPart.Position.Magnitude < 1 then
		return false
	end

	return true
end

local function isValidChest(obj)
	if not obj or not obj.Parent or not obj:IsDescendantOf(Workspace) then return false end
	if not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end
	if isPlayerOwned(obj) then return false end

	local lowerName = obj.Name:lower()
	if not (lowerName:find("chest1", 1, true) or lowerName:find("chest2", 1, true) or lowerName:find("chest3", 1, true) or lowerName == "chest") then
		return false
	end

	local targetPart = getTargetPart(obj)
	if not targetPart or targetPart.Position.Magnitude < 1 then
		return false
	end

	return true
end

local function isValidFlower(obj)
	if not obj or not obj.Parent or not obj:IsDescendantOf(Workspace) then return false end
	if not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end
	if isPlayerOwned(obj) then return false end

	local lowerName = obj.Name:lower()
	if not (lowerName == "flower1" or lowerName == "flower2") then
		return false
	end

	local targetPart = getTargetPart(obj)
	if not targetPart or targetPart.Position.Magnitude < 1 then
		return false
	end

	return true
end

local function makeTag(targetPart, tagName, displayText, color, enabledState)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = tagName
	billboard.Size = UDim2.new(0, 160, 0, 45)
	billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Enabled = enabledState
	billboard.Adornee = targetPart
	billboard.Parent = visualFolder

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = displayText
	textLabel.TextColor3 = color
	textLabel.TextStrokeTransparency = 0.3
	textLabel.TextSize = 14
	textLabel.Font = Enum.Font.GothamBold
	textLabel.Parent = billboard

	return billboard, textLabel
end

local function createFruitESP(obj)
	if trackedFruits[obj] or not isValidFruit(obj) then return end
	local targetPart = getTargetPart(obj)
	if not targetPart then return end

	local billboard, textLabel = makeTag(targetPart, "Fruit_Tag", obj.Name, Color3.fromRGB(255, 95, 110), fruitEspEnabled)
	trackedFruits[obj] = { Billboard = billboard, TextLabel = textLabel, TargetPart = targetPart }
end

local function createChestESP(obj)
	if trackedChests[obj] or not isValidChest(obj) then return end
	local targetPart = getTargetPart(obj)
	if not targetPart then return end

	local billboard, textLabel = makeTag(targetPart, "Chest_Tag", "Chest", Color3.fromRGB(255, 215, 70), chestEspEnabled)
	trackedChests[obj] = { Billboard = billboard, TextLabel = textLabel, TargetPart = targetPart }
end

local function createFlowerESP(obj)
	if trackedFlowers[obj] or not isValidFlower(obj) then return end
	local targetPart = getTargetPart(obj)
	if not targetPart then return end

	local flowerLabel = (obj.Name:lower() == "flower1") and "Blue Flower" or "Red Flower"
	local flowerColor = (obj.Name:lower() == "flower1") and Color3.fromRGB(90, 175, 255) or Color3.fromRGB(255, 80, 80)
	local billboard, textLabel = makeTag(targetPart, "Flower_Tag", flowerLabel, flowerColor, flowerEspEnabled)
	trackedFlowers[obj] = { Billboard = billboard, TextLabel = textLabel, TargetPart = targetPart }
end

local function clearTable(tbl)
	for _, data in pairs(tbl) do
		if data.Billboard then data.Billboard:Destroy() end
	end
	table.clear(tbl)
end

local function scanWorkspace()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if fruitEspEnabled and isValidFruit(obj) then
			createFruitESP(obj)
		end
		if chestEspEnabled and isValidChest(obj) then
			createChestESP(obj)
		end
		if flowerEspEnabled and isValidFlower(obj) then
			createFlowerESP(obj)
		end
	end
end

