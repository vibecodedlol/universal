local logEntries = {}
local lastPrompt = {}

local function recordPrompt(kind, id)
	if destroyed or id == nil then return end
	local key = kind .. ":" .. tostring(id)
	local now = os.clock()
	if lastPrompt[key] and now - lastPrompt[key] < 0.5 then return end
	lastPrompt[key] = now

	task.spawn(function()
		local info = getInfo(kind, id)
		if destroyed then return end
		knownKinds[tostring(id)] = kind

		local name = info and (info.Name or info.DisplayName) or ("ID " .. tostring(id))
		local price = info and (info.PriceInRobux or info.Price)
		local line = string.format("• %s [%s] (%s)%s",
			name,
			tostring(id),
			kind,
			price and (" - R$" .. commas(price)) or ""
		)

		table.insert(logEntries, 1, line)
		while #logEntries > 12 do
			table.remove(logEntries)
		end

		pcall(function()
			LoggerParagraph:SetDesc(table.concat(logEntries, "\n"))
		end)
	end)
end

local function firstId(...)
	for i = 1, select("#", ...) do
		local v = select(i, ...)
		if type(v) == "number" or (type(v) == "string" and v ~= "") then
			return v
		end
	end
end

